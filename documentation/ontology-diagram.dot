digraph ontology {
  rankdir=BT; nodesep=0.6; ranksep=0.9; bgcolor="white"; pad=0.3; splines=true;
  node [shape=plain, fontname="Helvetica", fontcolor="#1A1A1A"];
  edge [fontname="Helvetica", fontsize=10, fontcolor="#1A1A1A", color="#1A1A1A"];
  "lib:Genre" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F5FA8" BGCOLOR="#DCEBFA"><TR><TD ALIGN="CENTER"><B>lib:Genre</B></TD></TR></TABLE>>];
  "lib:LibraryBook" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F5FA8" BGCOLOR="#DCEBFA"><TR><TD ALIGN="CENTER"><B>lib:LibraryBook</B></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555"><I>added by us, declared in the ontology</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">lib:cataloguePosition : xsd:string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">lib:price : xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">lib:recordedIsbn : xsd:string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">lib:timesBorrowed : xsd:nonNegativeInteger</FONT></TD></TR><HR/><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9" COLOR="#555555"><I>reused from Schema.org</I></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">schema:name : xsd:string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">schema:datePublished : xsd:gYear</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">schema:inLanguage : xsd:string</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10">schema:keywords : xsd:string</FONT></TD></TR></TABLE>>];
  "lib:Section" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#1F5FA8" BGCOLOR="#DCEBFA"><TR><TD ALIGN="CENTER"><B>lib:Section</B></TD></TR></TABLE>>];
  "schema:Book" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6B6B6B" BGCOLOR="#F1F1F1"><TR><TD ALIGN="CENTER"><B>schema:Book</B></TD></TR></TABLE>>];
  "skos:Concept" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6B6B6B" BGCOLOR="#F1F1F1"><TR><TD ALIGN="CENTER"><B>skos:Concept</B></TD></TR></TABLE>>];
  "authors" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6B6B6B" BGCOLOR="#F1F1F1"><TR><TD ALIGN="CENTER"><B>schema:Person or schema:Organization</B></TD></TR></TABLE>>];
  "rating" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#6B6B6B" BGCOLOR="#F1F1F1"><TR><TD ALIGN="CENTER"><B>schema:AggregateRating</B></TD></TR></TABLE>>];
  "lib:Genre" -> "skos:Concept" [arrowhead=empty, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD><FONT COLOR="#1F5FA8" POINT-SIZE="10">subClassOf</FONT></TD></TR></TABLE>>, color="#1F5FA8"];
  "lib:LibraryBook" -> "schema:Book" [arrowhead=empty, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD><FONT COLOR="#1F5FA8" POINT-SIZE="10">subClassOf</FONT></TD></TR></TABLE>>, color="#1F5FA8"];
  "lib:Section" -> "skos:Concept" [arrowhead=empty, label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD><FONT COLOR="#1F5FA8" POINT-SIZE="10">subClassOf</FONT></TD></TR></TABLE>>, color="#1F5FA8"];
  "lib:Section" -> "lib:Genre" [dir=none, style=dashed, color="#B3261E", label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD><FONT COLOR="#B3261E" POINT-SIZE="10">disjointWith</FONT></TD></TR></TABLE>>, constraint=false];
  "lib:LibraryBook" -> "lib:Section" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD><FONT COLOR="#1F5FA8" POINT-SIZE="10">lib:inSection</FONT></TD></TR></TABLE>>, color="#1F5FA8", penwidth=1.6];
  "lib:LibraryBook" -> "authors" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD><FONT COLOR="#6B6B6B" POINT-SIZE="10">schema:author</FONT></TD></TR></TABLE>>, style=dashed, color="#6B6B6B"];
  "lib:LibraryBook" -> "lib:Genre" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD><FONT COLOR="#6B6B6B" POINT-SIZE="10">schema:genre</FONT></TD></TR></TABLE>>, style=dashed, color="#6B6B6B"];
  "lib:LibraryBook" -> "rating" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2" BGCOLOR="white"><TR><TD><FONT COLOR="#6B6B6B" POINT-SIZE="10">schema:aggregateRating</FONT></TD></TR></TABLE>>, style=dashed, color="#6B6B6B"];
  label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="3"><TR><TD ALIGN="LEFT"><FONT COLOR="#1F5FA8"><B>Blue</B></FONT> boxes and solid arrows: defined by us (prefix lib:)</TD></TR><TR><TD ALIGN="LEFT"><FONT COLOR="#6B6B6B"><B>Grey</B></FONT> boxes and dashed arrows: reused from Schema.org or SKOS</TD></TR><TR><TD ALIGN="LEFT">Hollow triangle: subClassOf. Red dashed line: disjointWith (a thing cannot be both).</TD></TR></TABLE>>; labelloc=b; labeljust=l; fontname="Helvetica"; fontsize=10;
}